# Required for protected API calls. Do not commit the real value.
ADMIN_TOKEN=replace-with-a-long-random-token

# Required for remote deployment. Netscape/Mozilla format, mounted read-only.
DOUYIN_COOKIE_FILE=./cookie/douyin-cookies.txt

# Must match the browser session that produced the Cookie.
DOUYIN_USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/130.0.0.0 Safari/537.36"

# Root directory for completed videos. User profiles are stored below this path.
DOWNLOAD_ROOT=./downloads

# Runtime state paths (optional; defaults point to the project state/ directory).
STATE_DIR=./state
DATABASE_FILE=./state/jobs.sqlite3
DOWNLOAD_ARCHIVE=./state/download-archive.txt
